---
import type { User } from '../../lib/types';
import { HOME_BY_ROLE, ROUTES } from '../../lib/constants';
import MobileNav from './MobileNav';

interface Props {
  user: User | null;
}

const { user } = Astro.props;

const panelHref = user ? HOME_BY_ROLE[user.role.name] : ROUTES.login;

/**
 * Enlaces institucionales del header, en el orden indicado por la organización.
 * Cada logo apunta al sitio oficial de su dependencia y abre en pestaña nueva.
 */
const INSTITUTIONAL_LINKS = [
  { href: 'https://www.unam.mx/', src: '/logos/unam.png', alt: 'UNAM' },
  { href: 'https://fad.unam.mx/', src: '/logos/fad.png', alt: 'Facultad de Artes y Diseño' },
  {
    href: 'https://posgrado.unam.mx/artesydiseno/',
    src: '/logos/posgrado.png',
    alt: 'Programa de Posgrado en Artes y Diseño',
  },
  {
    href: 'https://www.facebook.com/labrefadunam',
    src: '/logos/lab.png',
    alt: 'Laboratorio de la Facultad de Artes y Diseño',
  },
  {
    href: 'https://www.475.unam.mx/',
    src: '/logos/475.png',
    alt: '475 años de la Universidad de México',
  },
];
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-[#05003b]">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-3 px-4 sm:gap-4 sm:px-6">
    <!-- Logos institucionales: sustituyen al logotipo del sitio y al nav principal -->
    <div class="flex min-w-0 items-center gap-3 sm:gap-5 lg:gap-6">
      {
        INSTITUTIONAL_LINKS.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            title={item.alt}
            class="shrink-0 opacity-90 transition-opacity hover:opacity-100"
          >
            <img src={item.src} alt={item.alt} class="h-6 w-auto sm:h-8 md:h-14" />
          </a>
        ))
      }
    </div>

    <div class="hidden items-center gap-3 md:flex">
      {
        user ? (
          <a
            href={panelHref}
            class="rounded-lg bg-white px-4 py-2 text-sm font-semibold text-[#05003b] transition-colors hover:bg-blue-50"
          >
            Mi panel
          </a>
        ) : (
          <>
            <a
              href={ROUTES.login}
              class="text-sm font-medium text-white/80 transition-colors hover:text-white"
            >
              Iniciar sesión
            </a>
            <a
              href={ROUTES.register}
              class="rounded-lg bg-white px-4 py-2 text-sm font-semibold text-[#05003b] transition-colors hover:bg-blue-50"
            >
              Registrarse
            </a>
          </>
        )
      }
    </div>

    <MobileNav
      client:media="(max-width: 767px)"
      items={[]}
      panelHref={panelHref}
      loggedIn={Boolean(user)}
    />
  </div>
</header>
