---
import type { User } from '../../lib/types';
import { PUBLIC_NAV } from '../../lib/nav';
import { HOME_BY_ROLE, ROUTES } from '../../lib/constants';
import MobileNav from './MobileNav';

interface Props {
  user: User | null;
}

const { user } = Astro.props;
const currentPath = Astro.url.pathname;

const panelHref = user ? HOME_BY_ROLE[user.role.name] : ROUTES.login;
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={ROUTES.home} class="flex shrink-0 items-center gap-2 font-bold text-slate-900">
      <span class="grid h-9 w-9 place-items-center rounded-lg bg-blue-600 text-white">C</span>
      <span class="hidden sm:inline">Congreso 2026</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Principal">
      {
        PUBLIC_NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-sm font-medium transition-colors',
              currentPath === item.href
                ? 'text-blue-700'
                : 'text-slate-600 hover:text-slate-900',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      {
        user ? (
          <a
            href={panelHref}
            class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-700"
          >
            Mi panel
          </a>
        ) : (
          <>
            <a
              href={ROUTES.login}
              class="text-sm font-medium text-slate-600 transition-colors hover:text-slate-900"
            >
              Iniciar sesión
            </a>
            <a
              href={ROUTES.register}
              class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-700"
            >
              Registrarse
            </a>
          </>
        )
      }
    </div>

    <MobileNav
      client:media="(max-width: 767px)"
      items={PUBLIC_NAV}
      panelHref={panelHref}
      loggedIn={Boolean(user)}
    />
  </div>
</header>
