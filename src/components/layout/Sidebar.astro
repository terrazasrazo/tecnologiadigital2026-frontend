---
import type { User } from '../../lib/types';
import { navItemsFor } from '../../lib/nav';

interface Props {
  user: User;
  currentPath: string;
}

const { user, currentPath } = Astro.props;
const items = navItemsFor(user.role.name);
---

<aside
  class="sticky top-0 hidden h-screen w-64 shrink-0 flex-col border-r border-slate-200 bg-white lg:flex"
>
  <a href="/" class="flex h-16 items-center gap-2 border-b border-slate-200 px-6 font-bold text-slate-900">
    <span class="grid h-8 w-8 place-items-center rounded-lg bg-[#05003b] text-sm text-white">C</span>
    Tecnología Digital 2026
  </a>
  <nav class="flex flex-1 flex-col gap-1 p-4" aria-label="Panel">
    {
      items.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
            currentPath === item.href
              ? 'bg-blue-50 text-[#05003b]'
              : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900',
          ]}
          aria-current={currentPath === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="border-t border-slate-200 p-4 text-xs text-slate-500">
    <p class="truncate font-medium text-slate-700">{user.name} {user.lastName}</p>
    <p class="truncate">{user.email}</p>
  </div>
</aside>
