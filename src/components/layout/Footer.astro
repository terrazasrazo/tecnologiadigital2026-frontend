---
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-[#05003b] text-white">
  <div
    class="mx-auto max-w-7xl grid grid-cols-6 px-4 py-8 text-sm sm:flex-row sm:px-6"
  >
    <div class="col-span-1">
      <p class="font-semibold mb-2 text-white">Desarrollado por</p>
      <p>
        <a
            href="https://www.facebook.com/labrefadunam"
            target="_blank"
            rel="noopener noreferrer"
            title=""
            class="shrink-0 opacity-90 transition-opacity hover:opacity-100"
          >
            <img src="/logos/lab.png" alt="Laboratorio de Realidades Extendidas" class="h-6 w-auto sm:h-8 md:h-12" />
          </a>
      </p>
    </div>
    <div class="col-span-4">
      <p>Hecho en México, Universidad Nacional Autónoma de México (UNAM), todos los derechos reservados 2026.</p>
      <p>Esta página puede ser reproducida con fines no lucrativos, siempre y cuando no se mutile, se cite la fuente completa y su dirección electrónica.</p>
      <p>De otra forma, requiere permiso previo por escrito de la institución.</p>
    </div>
    <nav class="col-span-1 flex flex-col justify-center text-right" aria-label="Pie de página">
      <a href="/agenda" class="hover:text-slate-500 hover:underline">Agenda</a>
      <a href="/ponentes" class="hover:text-slate-500 hover:underline">Ponentes</a>
      <button
        type="button"
        class="my-2 text-right hover:text-slate-500 hover:underline"
        aria-haspopup="dialog"
        aria-controls="contacto-dialog"
        data-contacto-open
      >
        Contacto
      </button>
      <a href="https://fad.unam.mx/wp-content/uploads/2020/04/AvisoPrivacidd-Integral-Fac.pdf" target="_blank" rel="noopener noreferrer" class="mt-2 hover:text-slate-500 hover:underline">Aviso de Privacidad Integral</a>
    </nav>
  </div>
</footer>

<!-- Modal de contacto: el botón «Contacto» del pie lo abre -->
<dialog
  id="contacto-dialog"
  aria-labelledby="contacto-dialog-title"
  class="w-[calc(100%-2rem)] max-w-md rounded-2xl border border-slate-200 bg-white p-6 text-slate-900 shadow-xl"
>
  <div class="flex items-start justify-between gap-4">
    <h2 id="contacto-dialog-title" class="text-lg font-semibold text-slate-900">Contacto</h2>
    <button
      type="button"
      aria-label="Cerrar"
      data-contacto-close
      class="-m-1 shrink-0 rounded-lg p-1 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2} aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-slate-600">
    Si tienes alguna duda respecto al Coloquio y su agenda, con el proceso de registro, el acceso
    al sitio o el proceso de asistencia el día del evento escribe a{' '}
    <a
      href="mailto:coloquiotecnologiadigital@gmail.com"
      class="font-medium text-[#05003b] underline hover:no-underline"
    >
      coloquiotecnologiadigital@gmail.com
    </a>
  </p>
</dialog>

<script is:inline>
  (function () {
    var dialog = document.getElementById('contacto-dialog');
    if (!dialog) return;

    document.querySelectorAll('[data-contacto-open]').forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        dialog.showModal();
      });
    });

    dialog.querySelectorAll('[data-contacto-close]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        dialog.close();
      });
    });

    // Clic fuera del contenido (en el fondo) → cerrar. Esc lo cierra el navegador.
    dialog.addEventListener('click', function (event) {
      if (event.target === dialog) dialog.close();
    });
  })();
</script>
