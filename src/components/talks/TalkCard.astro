---
import type { Talk } from '../../lib/types';
import Badge from '../ui/Badge';
import { formatDayLabel, formatDuration } from '../../lib/utils';
import { formatClock, timeFormatFromCookie } from '../../lib/format';

interface Props {
  talk: Talk;
  /** Muestra la fecha (útil cuando la lista mezcla días). */
  showDate?: boolean;
}

const { talk, showDate = false } = Astro.props;
const timeFormat = timeFormatFromCookie(Astro.request.headers.get('cookie'));

const speakerNames = talk.speakers.map((s) => s.name).join(' · ') || 'Ponente por confirmar';
const locationLabel = talk.location
  ? talk.location.building
    ? `${talk.location.name} · ${talk.location.building}`
    : talk.location.name
  : 'Ubicación por definir';
const scheduled = talk.status === 'scheduled';
---

<article
  class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md"
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-sm font-semibold text-[#05003b]">
        {formatClock(talk.startTime, timeFormat)} – {formatClock(talk.endTime, timeFormat)}
        <span class="font-normal text-slate-400">· {formatDuration(talk.durationMinutes)}</span>
      </p>
      {showDate && <p class="mt-0.5 text-xs text-slate-500">{formatDayLabel(talk.date)}</p>}
      <h3 class="mt-1 text-lg font-semibold leading-snug text-slate-900">
        <a href={`/agenda/${talk.id}`} class="group-hover:underline">
          {talk.title}
        </a>
      </h3>
      <p class="mt-1 text-sm text-slate-600">{speakerNames}</p>
      <p class="mt-1 flex items-center gap-1.5 text-sm text-slate-500">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={1.5} aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
        </svg>
        {locationLabel}
      </p>
    </div>
    <Badge variant={scheduled ? 'green' : 'red'}>
      {scheduled ? 'Programada' : 'Cancelada'}
    </Badge>
  </div>
</article>
