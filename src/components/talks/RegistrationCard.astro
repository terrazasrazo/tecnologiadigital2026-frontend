---
import type { RegistrationStatus } from '../../lib/types';
import { formatDayLabel } from '../../lib/utils';
import { formatClock, timeFormatFromCookie } from '../../lib/format';
import RegistrationStatusBadge from '../attendance/RegistrationStatus';
import AttendanceButton from '../attendance/AttendanceButton';
import Badge from '../ui/Badge';

interface TalkInfo {
  id: number;
  title: string;
  date: string;
  startTime: string;
  endTime: string;
  locationName?: string | null;
}

interface Props {
  talk: TalkInfo;
  /** Estado de la inscripción (se muestra como insignia). */
  status?: RegistrationStatus;
  /**
   * Acción del botón:
   * - `cancel`: ya inscrito → botón de cancelar
   * - `register`: disponible → botón de inscribirse
   * - omitido: solo lectura
   */
  action?: 'register' | 'cancel';
  /** Ponencia cancelada (deshabilita el botón). */
  talkCancelled?: boolean;
}

const { talk, status, action, talkCancelled = false } = Astro.props;
const timeFormat = timeFormatFromCookie(Astro.request.headers.get('cookie'));
---

<article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-sm font-semibold text-[#05003b]">
        {formatDayLabel(talk.date)} · {formatClock(talk.startTime, timeFormat)} – {formatClock(talk.endTime, timeFormat)}
      </p>
      <h3 class="mt-1 text-base font-semibold leading-snug text-slate-900">
        <a href={`/agenda/${talk.id}`} class="hover:underline">{talk.title}</a>
      </h3>
      {
        talk.locationName && (
          <p class="mt-1 text-sm text-slate-500">{talk.locationName}</p>
        )
      }
    </div>
    {status && <RegistrationStatusBadge status={status} />}
    {!status && talkCancelled && <Badge variant="red">Ponencia cancelada</Badge>}
  </div>

  {
    action && (
      <div class="mt-4 border-t border-slate-100 pt-4">
        <AttendanceButton
          client:visible
          talkId={talk.id}
          registered={action === 'cancel'}
          talkCancelled={talkCancelled}
        />
      </div>
    )
  }
</article>
