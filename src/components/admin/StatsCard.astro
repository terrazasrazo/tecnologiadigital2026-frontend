---
interface Props {
  label: string;
  value: string | number;
  hint?: string;
  accent?: 'blue' | 'green' | 'amber' | 'slate' | 'red';
}

const { label, value, hint, accent = 'blue' } = Astro.props;

const ACCENTS = {
  blue: 'text-[#05003b] border-blue-100 bg-blue-50/50',
  green: 'text-emerald-600 border-emerald-100 bg-emerald-50/50',
  amber: 'text-amber-600 border-amber-100 bg-amber-50/50',
  slate: 'text-slate-700 border-slate-200 bg-slate-50',
  red: 'text-red-600 border-red-100 bg-red-50/50',
};
---

<div class:list={['rounded-xl border p-5', ACCENTS[accent]]}>
  <p class="text-xs font-semibold uppercase tracking-wide opacity-70">{label}</p>
  <p class="mt-1 text-3xl font-bold tabular-nums">{value}</p>
  {hint && <p class="mt-1 text-xs opacity-70">{hint}</p>}
</div>
