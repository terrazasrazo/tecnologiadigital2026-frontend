---
import '../styles/global.css';
import SeoHead from '../components/layout/SeoHead.astro';

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SeoHead title={title} noindex />
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center bg-slate-100 px-4 py-10">
    <a href="/" class="mb-8 flex items-center gap-2 text-lg font-bold text-slate-900">
      <span class="grid h-9 w-9 place-items-center rounded-lg bg-blue-600 text-white">C</span>
      Congreso 2026
    </a>
    <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <h1 class="text-xl font-semibold text-slate-900">{title}</h1>
      {subtitle && <p class="mt-1 text-sm text-slate-500">{subtitle}</p>}
      <div class="mt-6">
        <slot />
      </div>
    </div>
  </body>
</html>
