---
import PublicLayout from '../layouts/PublicLayout.astro';
import TalkCard from '../components/talks/TalkCard.astro';
import SpeakerCard from '../components/speakers/SpeakerCard.astro';
import { ROUTES } from '../lib/constants';
import { list as listTalks } from '../lib/api/talks';
import { list as listSpeakers } from '../lib/api/speakers';
import { fetchAllPages } from '../lib/api/helpers';
import type { Talk, Speaker } from '../lib/types';

// Si el backend no responde, la landing sigue siendo funcional (datos opcionales).
const [talksResult, speakersResult] = await Promise.allSettled([
  fetchAllPages(listTalks, {}),
  fetchAllPages(listSpeakers, {}),
]);

const talks: Talk[] = talksResult.status === 'fulfilled' ? talksResult.value : [];
const speakers: Speaker[] = speakersResult.status === 'fulfilled' ? speakersResult.value : [];

const sortBySchedule = (a: Talk, b: Talk) =>
  a.date.localeCompare(b.date) || a.startTime.localeCompare(b.startTime);

const today = new Date();
const todayIso = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

const upcoming = [...talks]
  .filter((t) => t.status === 'scheduled' && t.date >= todayIso)
  .sort(sortBySchedule)
  .slice(0, 3);
const upcomingPreview = upcoming.length > 0 ? upcoming : [...talks].sort(sortBySchedule).slice(0, 3);

const speakerPreview = [...speakers]
  .sort((a, b) => Number(Boolean(b.photoUrl)) - Number(Boolean(a.photoUrl)))
  .slice(0, 4);

const days = new Set(talks.map((t) => t.date)).size;

// JSON-LD: evento con el rango real de fechas de la agenda.
const sortedDates = [...new Set(talks.map((t) => t.date))].sort();
const site = (import.meta.env.PUBLIC_SITE_URL ?? 'http://localhost:4321').replace(/\/+$/, '');
const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Coloquio de Tecnología Digital 2026',
  description:
    'Congreso de tecnología digital: agenda de ponencias, ponentes, registro de asistentes y constancias.',
  url: `${site}/`,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  ...(sortedDates.length > 0
    ? { startDate: sortedDates[0], endDate: sortedDates[sortedDates.length - 1] }
    : {}),
  organizer: { '@type': 'Organization', name: 'Coloquio de Tecnología Digital 2026' },
};

const user = Astro.locals.user;
---

<PublicLayout
  title="Coloquio de Tecnología Digital 2026 — Información del evento"
  description="Agenda, ponentes y registro de asistentes del Coloquio de Tecnología Digital 2026."
>
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  <!-- Hero -->
  <section class="bg-[radial-gradient(circle_at_center,#121a7c,#05003b)] text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 lg:py-28">
      <p class="text-sm font-semibold uppercase tracking-widest text-blue-200">
        6 de noviembre 2026
      </p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-[#9adaff] sm:text-5xl lg:text-6xl">
        Coloquio de Tecnología Digital
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-blue-100">
        Reflexiones sobre el presente y futuro del arte y el diseño
      </p>

      <img
        src="/personaje.png"
        alt="Personaje con lentes de realidad virtual rodeado de un pincel, un astronauta, una molécula y un cubo"
        class="mx-auto mt-12 h-auto w-full max-w-2xl"
      />

      {
        talks.length > 0 && (
          <div class="mx-auto mt-10 flex max-w-2xl justify-center divide-x divide-blue-400/60 rounded-xl border border-blue-400/40 bg-blue-800/40 backdrop-blur">
            <div class="flex-1 px-4 py-4">
              <p class="text-2xl font-bold">{talks.length}</p>
              <p class="mt-0.5 text-xs uppercase tracking-wide text-blue-200">Ponencias</p>
            </div>
            <div class="flex-1 px-4 py-4">
              <p class="text-2xl font-bold">{speakers.length}</p>
              <p class="mt-0.5 text-xs uppercase tracking-wide text-blue-200">Ponentes</p>
            </div>
          </div>
        )
      }

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href={user ? ROUTES.app : ROUTES.register}
          class="rounded-lg bg-white px-6 py-3 font-semibold text-[#05003b] shadow-sm transition-colors hover:bg-blue-50"
        >
          {user ? 'Ir a mi panel' : 'Registrarme'}
        </a>
        <a
          href={ROUTES.agenda}
          class="rounded-lg border border-blue-400 px-6 py-3 font-semibold text-white transition-colors hover:bg-blue-800"
        >
          Ver agenda
        </a>
      </div>

    </div>
  </section>

  <!-- Próximas ponencias -->
  {
    upcomingPreview.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
        <div class="mb-6 flex items-end justify-between gap-4">
          <div>
            <h2 class="text-2xl font-bold text-slate-900">Ponencias destacadas</h2>
            <p class="mt-1 text-sm text-slate-500">Consulta los horarios de las ponencias</p>
          </div>
          <a
            href={ROUTES.agenda}
            class="text-sm font-semibold text-[#05003b] hover:underline"
          >
            Ver agenda completa →
          </a>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {upcomingPreview.map((talk) => (
            <TalkCard talk={talk} showDate={true} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Ponentes -->
  {
    speakerPreview.length > 0 && (
      <section class="bg-white">
        <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <h2 class="text-2xl font-bold text-slate-900">Ponentes</h2>
              <p class="mt-1 text-sm text-slate-500">
                Conoce a los especialistas que participan
              </p>
            </div>
            <a
              href={ROUTES.ponentes}
              class="text-sm font-semibold text-[#05003b] hover:underline"
            >
              Ver todos →
            </a>
          </div>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {speakerPreview.map((speaker) => (
              <SpeakerCard speaker={speaker} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Secciones rápidas -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <div class="grid gap-6 sm:grid-cols-2">
      <a
        href={ROUTES.agenda}
        class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
      >
        <h2 class="text-lg font-semibold text-slate-900">Agenda</h2>
        <p class="mt-2 text-sm text-slate-500">
          Consulta los horarios de las ponencias
        </p>
      </a>
      <a
        href={ROUTES.ponentes}
        class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
      >
        <h2 class="text-lg font-semibold text-slate-900">Ponentes</h2>
        <p class="mt-2 text-sm text-slate-500">
          Conoce a los especialistas que participan
        </p>
      </a>
      {/* <a
        href="/verificar/"
        class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
      >
        <h2 class="text-lg font-semibold text-slate-900">Verificar constancia</h2>
        <p class="mt-2 text-sm text-slate-500">
          Comprueba la autenticidad de una constancia por su código.
        </p>
      </a>*/}
    </div>
  </section>
</PublicLayout>
