---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout title="Página no encontrada">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="text-6xl font-bold text-[#05003b]">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-slate-900">Página no encontrada</h1>
    <p class="mt-2 text-slate-500">
      La página que buscas no existe o fue movida.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-[#05003b] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#121a7c]"
    >
      Volver al inicio
    </a>
  </section>
</PublicLayout>
