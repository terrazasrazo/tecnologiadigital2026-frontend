---
import AuthLayout from '../../layouts/AuthLayout.astro';
import RegisterForm from '../../components/auth/RegisterForm';
---

<AuthLayout title="Crear cuenta" subtitle="Regístrate como asistente del congreso.">
  <RegisterForm client:load />
  <p class="mt-6 text-center text-sm text-slate-500">
    ¿Ya tienes cuenta?
    <a href="/auth/login" class="font-medium text-blue-600 hover:text-blue-700">Inicia sesión</a>
  </p>
</AuthLayout>
