---
import AuthLayout from '../../layouts/AuthLayout.astro';
---

<AuthLayout title="Crear cuenta" subtitle="Regístrate como asistente del congreso.">
  <!-- Formulario completo en el Milestone 2 (Auth). -->
  <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-4 text-center text-sm text-slate-500">
    Formulario de registro — Milestone 2.
  </div>
  <p class="mt-6 text-center text-sm text-slate-500">
    ¿Ya tienes cuenta?
    <a href="/auth/login" class="font-medium text-blue-600 hover:text-blue-700">Inicia sesión</a>
  </p>
</AuthLayout>
