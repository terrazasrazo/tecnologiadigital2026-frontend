---
import AuthLayout from '../../layouts/AuthLayout.astro';
---

<AuthLayout title="Iniciar sesión" subtitle="Accede a tu panel del congreso.">
  <!-- Formulario completo en el Milestone 2 (Auth). -->
  <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-4 text-center text-sm text-slate-500">
    Formulario de acceso — Milestone 2.
  </div>
  <p class="mt-6 text-center text-sm text-slate-500">
    ¿No tienes cuenta?
    <a href="/auth/register" class="font-medium text-blue-600 hover:text-blue-700">Regístrate</a>
  </p>
</AuthLayout>
