---
import AuthLayout from '../../layouts/AuthLayout.astro';
import ResetPasswordForm from '../../components/auth/ResetPasswordForm';
import ForgotPasswordForm from '../../components/auth/ForgotPasswordForm';

const token = Astro.url.searchParams.get('token');
---

<AuthLayout title="Nueva contraseña" subtitle="Define tu nueva contraseña.">
  {
    token ? (
      <ResetPasswordForm client:load token={token} />
    ) : (
      <div class="flex flex-col gap-4">
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
          El enlace de recuperación no es válido o está incompleto. Solicita uno nuevo.
        </div>
        <ForgotPasswordForm client:load />
      </div>
    )
  }
</AuthLayout>
