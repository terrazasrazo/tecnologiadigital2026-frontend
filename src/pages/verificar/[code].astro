---
import SimpleLayout from '../../layouts/SimpleLayout.astro';
import VerifyResult from '../../components/certificates/VerifyResult.astro';
import { verify } from '../../lib/api/certificates';
import { ApiError } from '../../lib/utils';
import { messageFor } from '../../lib/errorMessages';

const code = Astro.params.code ?? '';

let result = null;
let error: string | null = null;

if (!code) {
  error = 'No se proporcionó un código de verificación.';
} else {
  try {
    result = await verify(code);
  } catch (err) {
    if (err instanceof ApiError) {
      error =
        err.status === 404
          ? 'No existe ninguna constancia con ese código.'
          : messageFor(err.code, err.message);
    } else {
      error = 'No se pudo verificar la constancia.';
    }
  }
}
---

<SimpleLayout
  title="Verificar constancia"
  description="Verificación pública de constancias del Congreso 2026."
>
  <div class="py-8">
    <h1 class="text-2xl font-bold text-slate-900">Verificación de constancia</h1>
    <p class="mt-2 text-sm text-slate-500">
      Resultado de la consulta con el código
      <span class="font-mono text-slate-700">{code || '(sin código)'}</span>.
    </p>

    <div class="mt-6">
      <VerifyResult result={result} error={error} code={code} />
    </div>

    <p class="mt-8 text-sm text-slate-500">
      <a href="/verificar/" class="font-medium text-blue-600 hover:text-blue-700">
        Verificar otro código
      </a>
      <span class="mx-2">·</span>
      <a href="/" class="font-medium text-blue-600 hover:text-blue-700">Volver al inicio</a>
    </p>
  </div>
</SimpleLayout>
